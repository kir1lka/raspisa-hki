DOMAIN=raspisahki.ru

DB_PASSWORD=change-me-strong-password

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Напоминание в день мероприятия. Формат cron: секунды минуты часы день месяц день-недели.
# Обе строки можно не задавать — тогда рассылка идёт в 08:00 по московскому времени.
REMINDER_CRON=0 0 8 * * *
REMINDER_ZONE=Europe/Moscow
